{
  "name": "@skill-map/web",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "skill-map.ai public site source. Static HTML + i18n; deployed via Caddy/Docker.",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "predemo:build": "rm -f ../fixtures/demo/.skill-map/skill-map.db ../fixtures/demo/.skill-map/skill-map.db-wal ../fixtures/demo/.skill-map/skill-map.db-shm && rm -rf ../fixtures/demo/.skill-map/backups",
    "demo:build": "node scripts/ensure-ui-build.js && rm -rf demo && node scripts/build-demo-dataset.js && cp -R ../ui/dist/ui/browser/. demo/ && node scripts/patch-demo-mode.js",
    "demo:serve": "node scripts/serve-demo.js",
    "build": "pnpm demo:build && node scripts/build-site.js",
    "docker:build": "docker build -t skill-map-test ..",
    "docker:run": "docker run --rm -p 8080:8080 skill-map-test",
    "docker": "pnpm docker:build && pnpm docker:run",
    "validate": "pnpm validate:compile",
    "validate:compile": "pnpm build"
  },
  "engines": {
    "node": ">=24.0"
  }
}
