{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ui": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "sm",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@foblex/flow/styles/default.scss",
              "node_modules/primeicons/primeicons.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
              "src/styles.css",
              "src/themes/light.css",
              "src/themes/dark.css",
              "src/themes/matrix.css",
              "src/themes/neon.css",
              "src/themes/neon-green.css",
              "src/themes/neon-red.css",
              "src/themes/blueprint.css",
              "src/themes/paper.css",
              "src/themes/highlight.css"
            ],
            "allowedCommonJsDependencies": [
              "dagre"
            ],
            "progress": false
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "1.1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kB",
                  "maximumError": "30kB"
                }
              ],
              "outputHashing": "all"
            },
            "analyze": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "1.1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kB",
                  "maximumError": "30kB"
                }
              ],
              "outputHashing": "all",
              "sourceMap": {
                "scripts": true,
                "styles": false,
                "hidden": false,
                "vendor": true
              }
            },
            "release-sourcemaps": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "1.1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kB",
                  "maximumError": "30kB"
                }
              ],
              "outputHashing": "all",
              "sourceMap": {
                "scripts": true,
                "styles": false,
                "hidden": true,
                "vendor": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "dev-demo": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "index": "src/index.demo.html",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "data*.json",
                  "input": "../web/demo",
                  "output": "/"
                }
              ]
            },
            "dev-stamped": {
              "index": {
                "input": "src/index.dev.html",
                "output": "index.html"
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ui:build:production"
            },
            "development": {
              "buildTarget": "ui:build:development"
            },
            "dev-demo": {
              "buildTarget": "ui:build:dev-demo"
            },
            "local": {
              "buildTarget": "ui:build:development,dev-stamped",
              "proxyConfig": "proxy.conf.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "setupFiles": [
              "src/test-setup.ts"
            ],
            "runnerConfig": "vitest.config.ts"
          }
        }
      }
    }
  }
}
